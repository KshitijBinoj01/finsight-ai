# MySQL connection. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://finsight_app:CHANGE_ME@127.0.0.1:3306/finsight_ai?charset=utf8mb4

# Generate a long random value before using outside local development.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# Enables /api/auth/demo only for local project demonstrations.
# Keep false for any deployed environment.
ALLOW_DEMO_LOGIN=true

# CORS origins for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
